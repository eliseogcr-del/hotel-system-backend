# Supabase - Proyecto del sistema hotelero
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx
# Service role key: solo para operaciones de servidor que necesiten saltar RLS
# (ej. importaciones de Booking/Airbnb). NUNCA exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx
# Dashboard de Supabase > Settings > API > JWT Settings > JWT Secret. Se usa
# para validar los access tokens localmente (AuthGuard) en vez de llamarlo
# por red en cada request. NUNCA exponerla al frontend.
SUPABASE_JWT_SECRET=xxxxx

PORT=3000
NODE_ENV=development
